def load_csv(path, cols):
    if not os.path.exists(path): return pd.DataFrame(columns=cols)
    df = pd.read_csv(path, header=None, dtype=str, na_values=['NA','N/A','',' '], skipinitialspace=True)
    if len(df) == 0: return pd.DataFrame(columns=cols)
    if str(df.iloc[0,0]).strip().strip('"') == cols[0]:
        df = df.iloc[1:].reset_index(drop=True)
    m = min(df.shape[1], len(cols))
    df = df.iloc[:, :m].copy()
    df.columns = cols[:m]
    return df

