# ==============================================================================
# SECTION 3: Neural Network Architectures
# ==============================================================================
H, BS = 96, 512

class RiskLayer(nn.Module):
    def __init__(self, h):
        super().__init__()
        self.gate = nn.Sequential(nn.Linear(h, h), nn.Sigmoid())
    def forward(self, h):
        return h * self.gate(h)

class BottomModel(nn.Module):
    def __init__(self, inp, h=H):
        super().__init__()
        self.ffnn = nn.Sequential(
            nn.Linear(inp, h), nn.ReLU(), nn.BatchNorm1d(h), nn.Dropout(0.2),
            nn.Linear(h, h), nn.ReLU(), nn.BatchNorm1d(h), nn.Dropout(0.2)
        )
        self.risk = RiskLayer(h)
    def forward(self, x):
        return self.risk(self.ffnn(x))

class TopModel(nn.Module):
    def __init__(self, h=H, n_cls=3):
        super().__init__()
        self.tr = nn.TransformerEncoder(
            nn.TransformerEncoderLayer(d_model=h, nhead=4,
                                       batch_first=True, dropout=0.1),
            num_layers=2
        )
        self.fc = nn.Sequential(
            nn.Linear(h, h//2), nn.ReLU(), nn.BatchNorm1d(h//2),
            nn.Dropout(0.2), nn.Linear(h//2, n_cls)
        )
    def forward(self, e):
        return self.fc(self.tr(e).mean(dim=1))

class SmallNet(nn.Module):
    def __init__(self, in_dim):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(in_dim, 64), nn.ReLU(), nn.BatchNorm1d(64), nn.Dropout(0.2),
            nn.Linear(64, 64), nn.ReLU(), nn.Linear(64, 3)
        )
    def forward(self, x):
        return self.net(x)

# ==============================================================================
# SECTION 4: Aggregation Rules (Byzantine-Robust)
# ==============================================================================
class ZeroTrustAggregator:
    """Statistical deviation-based zero-trust verification layer."""
    def __init__(self, tau=3.0, mom=0.9):
        self.tau, self.mom, self.mu, self.var = tau, mom, None, None

    def verify(self, grads):
        norms = torch.stack([g.norm() for g in grads])
        if self.mu is None:
            self.mu = norms.mean().item()
            self.var = norms.var().item() if len(norms) > 1 else 1.0
        std = max(np.sqrt(self.var), 1e-5)
        w = [1.0 if abs(n.item() - self.mu) / std < self.tau else 0.05 for n in norms]
        self.mu = self.mom * self.mu + (1 - self.mom) * norms.mean().item()
        self.var = self.mom * self.var + (1 - self.mom) * (
            norms.var().item() if len(norms) > 1 else 0.0
        )
        return w

class KrumAggregator:
    """Krum aggregation (Blanchard et al., NeurIPS 2017)."""
    def __init__(self, n_clients=3, f_malicious=1):
        self.n, self.f = n_clients, f_malicious

    def aggregate(self, grads):
        n = len(grads)
        distances = np.zeros((n, n))
        for i in range(n):
            for j in range(i+1, n):
                dist = torch.norm(grads[i] - grads[j]).item()
                distances[i, j] = dist
                distances[j, i] = dist
        k = max(1, n - self.f - 2)
        scores = [np.sum(np.sort(distances[i])[1:k+1]) for i in range(n)]
        scores = np.array(scores)
        weights = 1.0 / (scores + 1e-6)
        return (weights / weights.sum()).tolist()

def rkrum_aggregate(grads):
    """rKrum aggregation with adaptive f-estimation."""
    n = len(grads)
    norms = torch.stack([g.norm() for g in grads])
    mu, std = norms.mean(), norms.std()
    f = int((norms > mu + 2*std).sum().item()) if std > 1e-5 else 0
    f = min(f, 1)
    distances = torch.zeros((n, n))
    for i in range(n):
        for j in range(n):
            distances[i, j] = torch.norm(grads[i] - grads[j])
    k = max(1, n - f - 2)
    scores = []
    for i in range(n):
        scores.append(torch.sort(distances[i])[0][1:k+1].sum().item())
    scores = np.array(scores)
    weights = 1.0 / (scores + 1e-6)
    return (weights / weights.sum()).tolist()

def arkrum_aggregate(grads):
    """ArKrum aggregation with pre-filtering and adaptive f-hat estimation."""
    n = len(grads)
    norms = torch.stack([g.norm() for g in grads])
    mu, std = norms.mean(), norms.std()
    keep = [i for i in range(n) if norms[i] <= mu + 2*std or std < 1e-5]
    if len(keep) < 2:
        keep = list(range(n))
    f_hat = min(n - len(keep), 1)
    distances = torch.zeros((len(keep), len(keep)))
    for i_idx, i in enumerate(keep):
        for j_idx, j in enumerate(keep):
            distances[i_idx, j_idx] = torch.norm(grads[i] - grads[j])
    k = max(1, len(keep) - f_hat - 2)
    scores = []
    for i in range(len(keep)):
        scores.append(torch.sort(distances[i])[0][1:k+1].sum().item())
    weights_kept = 1.0 / (np.array(scores) + 1e-6)
    weights_kept = weights_kept / weights_kept.sum()
    final_weights = [0.0] * n
    for idx, i in enumerate(keep):
        final_weights[i] = weights_kept[idx]
    return final_weights

def compute_aggregation_weights(aggregator_name, grads, zt_obj):
    """Compute final aggregation weights combining ZT with chosen aggregator."""
    if aggregator_name == 'mean':
        base_w = [1.0 / len(grads)] * len(grads)
    elif aggregator_name == 'krum':
        base_w = KrumAggregator(n_clients=len(grads), f_malicious=1).aggregate(grads)
    elif aggregator_name == 'rkrum':
        base_w = rkrum_aggregate(grads)
    elif aggregator_name == 'arkrum':
        base_w = arkrum_aggregate(grads)
    else:
        base_w = [1.0 / len(grads)] * len(grads)

    if zt_obj is not None:
        zt_w = zt_obj.verify(grads)
        combined = [w * zw for w, zw in zip(base_w, zt_w)]
        s = sum(combined)
        if s > 0:
            combined = [w / s for w in combined]
        else:
            combined = [1.0 / len(grads)] * len(grads)
        return combined
    return base_w

def pad_features(X, w=9):
    if X.shape[1] < w:
        return np.hstack([X, np.zeros((X.shape[0], w - X.shape[1]))])
    return X[:, :w]

# ==============================================================================
# SECTION 5: Statistical Analysis Functions
# ==============================================================================
def compute_statistics(values):
    """Compute mean, standard deviation, and 95% confidence interval."""
    arr = np.array(values)
    n = len(arr)
    mean = arr.mean()
    std = arr.std(ddof=1) if n > 1 else 0.0
    if n > 1 and std > 0:
        ci_low, ci_high = stats.t.interval(0.95, n-1, loc=mean, scale=std/np.sqrt(n))
    else:
        ci_low, ci_high = mean, mean
    return {
        'mean': mean, 'std': std,
        'ci_low': ci_low, 'ci_high': ci_high,
        'values': arr.tolist()
    }

def format_stat(stat, decimals=2):
    """Format: mean +/- std [ci_low, ci_high]."""
    return (f"{stat['mean']:.{decimals}f} ± {stat['std']:.{decimals}f} "
            f"[{stat['ci_low']:.{decimals}f}, {stat['ci_high']:.{decimals}f}]")

def compute_pr_auc(y_true, y_proba):
    """Compute macro-average PR-AUC for multi-class classification."""
    try:
        n_classes = y_proba.shape[1]
        pr_aucs = []
        for c in range(n_classes):
            y_c = (y_true == c).astype(int)
            if y_c.sum() == 0 or y_c.sum() == len(y_c):
                continue
            precision, recall, _ = precision_recall_curve(y_c, y_proba[:, c])
            pr_aucs.append(auc(recall, precision))
        return np.mean(pr_aucs) if pr_aucs else np.nan
    except Exception:
        return np.nan

# ==============================================================================
# SECTION 6: PART 0 - Centralized Baseline (Upper Bound)
# ==============================================================================
def run_part0_centralized(seed, epochs=15, lr=1e-3):
    """Centralized training on all data (theoretical upper bound)."""
    set_all_seeds(seed)
    X_all = np.hstack([ZA, ZB, ZC])
    X_tr, X_te, y_tr, y_te = train_test_split(
        X_all, y_all, test_size=0.2, random_state=seed, stratify=y_all
    )
    in_dim = X_tr.shape[1]
    model = SmallNet(in_dim)

    dl = DataLoader(
        TensorDataset(torch.tensor(X_tr, dtype=torch.float32),
                      torch.tensor(y_tr, dtype=torch.long)),
        batch_size=512, shuffle=True,
        worker_init_fn=seed_worker, generator=make_generator(seed)
    )
    opt = optim.Adam(model.parameters(), lr=lr)
    cr = nn.CrossEntropyLoss()

    model.train()
    for ep in range(epochs):
        for xb, yb in dl:
            opt.zero_grad()
            loss = cr(model(xb), yb)
            loss.backward()
            opt.step()

    model.eval()
    with torch.no_grad():
        pr = torch.softmax(model(torch.tensor(X_te, dtype=torch.float32)), 1).numpy()
        P = pr.argmax(1)
        L = y_te

    r = classification_report(L, P, output_dict=True, zero_division=0)
    acc = r['accuracy'] * 100
    f1 = r['macro avg']['f1-score'] * 100
    try:
        roc = roc_auc_score(L, pr, multi_class='ovr', average='macro')
    except Exception:
        roc = np.nan
    pr_auc = compute_pr_auc(L, pr)

    # Per-class metrics
    per_class = {}
    for c in [0, 1, 2]:
        per_class[f'precision_class{c}'] = r[str(c)]['precision'] * 100
        per_class[f'recall_class{c}'] = r[str(c)]['recall'] * 100

    return acc, f1, roc, pr_auc, per_class

# ==============================================================================
# SECTION 7: PART 1 - HFL Benchmark (10 Clients, Sample Partitioning) [FIXED]
# ==============================================================================
def run_part1_hfl(seed, n_clients=10, f_attack=0, aggregator='krum',
                  epochs=5, lr=1e-3, poison_scale=-5.0):
    """Horizontal FL experiment with sample-wise partitioning."""
    set_all_seeds(seed)
    X_all = np.hstack([ZA, ZB, ZC])
    X_tr, X_te, y_tr, y_te = train_test_split(
        X_all, y_all, test_size=0.2, random_state=seed, stratify=y_all
    )
    in_dim = X_tr.shape[1]
    idx = np.arange(len(X_tr))
    np.random.shuffle(idx)
    shards = np.array_split(idx, n_clients)
    malicious = set(range(n_clients - f_attack, n_clients))

    server = SmallNet(in_dim)

    for rnd in range(epochs):
        server.train()
        client_deltas = []
        for k in range(n_clients):
            ck = SmallNet(in_dim)
            ck.load_state_dict(server.state_dict())
            Xk, yk = X_tr[shards[k]], y_tr[shards[k]]
            dl = DataLoader(
                TensorDataset(torch.tensor(Xk, dtype=torch.float32),
                              torch.tensor(yk, dtype=torch.long)),
                batch_size=256, shuffle=True,
                worker_init_fn=seed_worker, generator=make_generator(seed+k)
            )
            opt = optim.Adam(ck.parameters(), lr=lr)
            cr = nn.CrossEntropyLoss()
            ck.train()
            for xb, yb in dl:
                opt.zero_grad()
                loss = cr(ck(xb), yb)
                loss.backward()
                opt.step()

            # FIX: FedAvg uses weight differences (Delta W), not last-batch gradients
            delta_w = torch.cat([p.flatten().clone() for p in ck.parameters()]) - \
                      torch.cat([p.flatten().clone() for p in server.parameters()])

            if k in malicious:
                delta_w = delta_w * poison_scale
            client_deltas.append(delta_w)

        zt = ZeroTrustAggregator()
        weights = compute_aggregation_weights(aggregator, client_deltas, zt)

        with torch.no_grad():
            agg_delta = sum(w * g for w, g in zip(weights, client_deltas))
            offset = 0
            for p in server.parameters():
                numel = p.numel()
                p.add_(agg_delta[offset:offset+numel].view(p.shape))
                offset += numel

    server.eval()
    with torch.no_grad():
        pr = torch.softmax(
            server(torch.tensor(X_te, dtype=torch.float32)), 1
        ).numpy()
        P = pr.argmax(1)
        L = y_te

    r = classification_report(L, P, output_dict=True, zero_division=0)
    acc = r['accuracy'] * 100
    f1 = r['macro avg']['f1-score'] * 100
    try:
        roc = roc_auc_score(L, pr, multi_class='ovr', average='macro')
    except Exception:
        roc = np.nan
    pr_auc = compute_pr_auc(L, pr)

    per_class = {}
    for c in [0, 1, 2]:
        per_class[f'precision_class{c}'] = r[str(c)]['precision'] * 100
        per_class[f'recall_class{c}'] = r[str(c)]['recall'] * 100

    return acc, f1, roc, pr_auc, per_class

# ==============================================================================
# SECTION 8: PART 2 - VFL Benchmark (10 Clients, Feature Partitioning) [FIXED]
# ==============================================================================
def run_part2_vfl(seed, n_clients=10, f_attack=0, epochs=5, lr=1e-3,
                  poison_scale=-5.0):
    """Vertical FL experiment with feature-wise partitioning."""
    set_all_seeds(seed)
    X_all = np.hstack([ZA, ZB, ZC])
    X_tr, X_te, y_tr, y_te = train_test_split(
        X_all, y_all, test_size=0.2, random_state=seed, stratify=y_all
    )
    feat_chunks = np.array_split(np.arange(X_all.shape[1]), n_clients)
    max_in = max(len(c) for c in feat_chunks)

    class BottomNet(nn.Module):
        def __init__(self):
            super().__init__()
            self.net = nn.Sequential(
                nn.Linear(max_in, 32), nn.ReLU(), nn.Linear(32, 32)
            )
        def forward(self, x):
            return self.net(x)

    class TopNet(nn.Module):
        def __init__(self):
            super().__init__()
            self.net = nn.Sequential(
                nn.Linear(n_clients * 32, 64), nn.ReLU(), nn.Linear(64, 3)
            )
        def forward(self, e):
            return self.net(e)

    server_bottoms = [BottomNet() for _ in range(n_clients)]
    top_net = TopNet()
    malicious = set(range(n_clients - f_attack, n_clients))

    dl = DataLoader(
        TensorDataset(torch.tensor(X_tr, dtype=torch.float32),
                      torch.tensor(y_tr, dtype=torch.long)),
        batch_size=256, shuffle=True,
        worker_init_fn=seed_worker, generator=make_generator(seed)
    )
    opt_top = optim.Adam(top_net.parameters(), lr=lr)
    cr = nn.CrossEntropyLoss()

    for rnd in range(epochs):
        client_bottoms = [BottomNet() for _ in range(n_clients)]
        for k in range(n_clients):
            client_bottoms[k].load_state_dict(server_bottoms[k].state_dict())
        opts_b = [optim.Adam(cb.parameters(), lr=lr) for cb in client_bottoms]

        for xb, yb in dl:
            opt_top.zero_grad()
            for o in opts_b:
                o.zero_grad()
            embs = []
            for k in range(n_clients):
                x_k = xb[:, feat_chunks[k]]
                if x_k.shape[1] < max_in:
                    x_k = torch.cat([
                        x_k, torch.zeros(x_k.shape[0], max_in - x_k.shape[1])
                    ], dim=1)
                embs.append(client_bottoms[k](x_k))
            loss = cr(top_net(torch.cat(embs, dim=1)), yb)
            loss.backward()
            opt_top.step()
            for o in opts_b:
                o.step()

        # Aggregate BottomNets with ZT
        w_s = [torch.cat([p.flatten().clone() for p in sb.parameters()])
               for sb in server_bottoms]
        deltas = []
        for k in range(n_clients):
            dk = torch.cat([p.flatten().clone() for p in client_bottoms[k].parameters()]) - w_s[k]
            if k in malicious:
                dk = dk * poison_scale
            deltas.append(dk)

        # FIX: Use weights from verify() directly instead of unpacking 3 variables
        zt = ZeroTrustAggregator()
        weights = zt.verify(deltas)

        # Accept clients that passed the ZT check (weight > 0.5 means trusted)
        keep_set = set(i for i, w in enumerate(weights) if w > 0.5)
        if len(keep_set) == 0:
            keep_set = set(range(n_clients))

        for k in range(n_clients):
            if k in keep_set:
                server_bottoms[k].load_state_dict(client_bottoms[k].state_dict())

    top_net.eval()
    for sb in server_bottoms:
        sb.eval()
    P, L = [], []
    with torch.no_grad():
        for i in range(0, len(X_te), 2048):
            xb = torch.tensor(X_te[i:i+2048], dtype=torch.float32)
            embs = []
            for k in range(n_clients):
                x_k = xb[:, feat_chunks[k]]
                if x_k.shape[1] < max_in:
                    x_k = torch.cat([
                        x_k, torch.zeros(x_k.shape[0], max_in - x_k.shape[1])
                    ], dim=1)
                embs.append(server_bottoms[k](x_k))
            P += top_net(torch.cat(embs, dim=1)).argmax(1).tolist()
            L += y_te[i:i+2048].tolist()

    L = np.array(L)
    P = np.array(P)
    r = classification_report(L, P, output_dict=True, zero_division=0)
    acc = r['accuracy'] * 100
    f1 = r['macro avg']['f1-score'] * 100

    # Compute probabilities for ROC-AUC and PR-AUC
    top_net.eval()
    for sb in server_bottoms:
        sb.eval()
    all_pr = []
    with torch.no_grad():
        for i in range(0, len(X_te), 2048):
            xb = torch.tensor(X_te[i:i+2048], dtype=torch.float32)
            embs = []
            for k in range(n_clients):
                x_k = xb[:, feat_chunks[k]]
                if x_k.shape[1] < max_in:
                    x_k = torch.cat([
                        x_k, torch.zeros(x_k.shape[0], max_in - x_k.shape[1])
                    ], dim=1)
                embs.append(server_bottoms[k](x_k))
            all_pr.append(torch.softmax(top_net(torch.cat(embs, dim=1)), 1).numpy())
    all_pr = np.vstack(all_pr)

    try:
        roc = roc_auc_score(L, all_pr, multi_class='ovr', average='macro')
    except Exception:
        roc = np.nan
    pr_auc = compute_pr_auc(L, all_pr)

    per_class = {}
    for c in [0, 1, 2]:
        per_class[f'precision_class{c}'] = r[str(c)]['precision'] * 100
        per_class[f'recall_class{c}'] = r[str(c)]['recall'] * 100

    return acc, f1, roc, pr_auc, per_class

# ==============================================================================
# SECTION 9: PART 3 - VFL Multi-Cloud Attack (3 Domain Clients)
# ==============================================================================
class VFLDataset(Dataset):
    def __init__(self, X1, X2, X3, y):
        self.X1 = torch.tensor(X1, dtype=torch.float32)
        self.X2 = torch.tensor(X2, dtype=torch.float32)
        self.X3 = torch.tensor(X3, dtype=torch.float32)
        self.y = torch.tensor(y, dtype=torch.long)
    def __len__(self):
        return len(self.y)
    def __getitem__(self, i):
        return self.X1[i], self.X2[i], self.X3[i], self.y[i]

def run_part3_multicloud(seed, attack_clients=None, attack_scale=1.0,
                         aggregator='krum', epochs=6, lr=1e-3):
    """Multi-cloud VFL experiment with Hospital, Insurance, Pharmacy domains."""
    set_all_seeds(seed)
    idx = np.arange(len(df))
    tr_i, tmp_i = train_test_split(idx, test_size=0.4, random_state=seed, stratify=y_all)
    val_i, te_i = train_test_split(tmp_i, test_size=0.5, random_state=seed,
                                   stratify=y_all[tmp_i])
    y_tr, y_val, y_te = y_all[tr_i], y_all[val_i], y_all[te_i]

    scA = StandardScaler().fit(df.iloc[tr_i][FEAT_A])
    scB = StandardScaler().fit(df.iloc[tr_i][FEAT_B])
    scC = StandardScaler().fit(df.iloc[tr_i][FEAT_C])
    X1_tr = pad_features(scA.transform(df.iloc[tr_i][FEAT_A]))
    X1_val = pad_features(scA.transform(df.iloc[val_i][FEAT_A]))
    X1_te = pad_features(scA.transform(df.iloc[te_i][FEAT_A]))
    X2_tr = pad_features(scB.transform(df.iloc[tr_i][FEAT_B]))
    X2_val = pad_features(scB.transform(df.iloc[val_i][FEAT_B]))
    X2_te = pad_features(scB.transform(df.iloc[te_i][FEAT_B]))
    X3_tr = pad_features(scC.transform(df.iloc[tr_i][FEAT_C]))
    X3_val = pad_features(scC.transform(df.iloc[val_i][FEAT_C]))
    X3_te = pad_features(scC.transform(df.iloc[te_i][FEAT_C]))

    vfl_tr = DataLoader(VFLDataset(X1_tr, X2_tr, X3_tr, y_tr),
                        batch_size=BS, shuffle=True,
                        worker_init_fn=seed_worker, generator=make_generator(seed))
    vfl_val = DataLoader(VFLDataset(X1_val, X2_val, X3_val, y_val), batch_size=BS*2)
    vfl_te = DataLoader(VFLDataset(X1_te, X2_te, X3_te, y_te), batch_size=BS*2)

    counts = np.bincount(y_tr, minlength=3).astype(float)
    CW = torch.tensor(1.0 / np.clip(counts, 1, None), dtype=torch.float32)
    CW = CW / CW.sum() * 3

    models = [BottomModel(9, H) for _ in range(3)]
    top = TopModel(H)
    opts = [optim.AdamW(m.parameters(), lr=lr, weight_decay=1e-4) for m in models] + \
           [optim.AdamW(top.parameters(), lr=lr, weight_decay=1e-4)]
    cr = nn.CrossEntropyLoss(weight=CW)

    f_mal = len(attack_clients) if attack_clients else 0
    agg = KrumAggregator(n_clients=3, f_malicious=min(1, f_mal)) if f_mal < 2 else None
    use_zt = attack_clients is not None
    zt = ZeroTrustAggregator() if use_zt else None

    best_f1, best_state = -1, None
    for ep in range(epochs):
        for m in models:
            m.train()
        top.train()
        for x1, x2, x3, y in vfl_tr:
            for o in opts:
                o.zero_grad()
            em = [m(x) for m, x in zip(models, [x1, x2, x3])]
            loss = cr(top(torch.stack(em, dim=1)), y)
            loss.backward()
            if attack_clients:
                for mc in attack_clients:
                    for p in models[mc].parameters():
                        if p.grad is not None:
                            p.grad.data.mul_(attack_scale)
            for m in models:
                torch.nn.utils.clip_grad_norm_(m.parameters(), 1.0)
            torch.nn.utils.clip_grad_norm_(top.parameters(), 1.0)

            if agg is not None or zt is not None:
                grads = [
                    torch.cat([p.grad.flatten() for p in m.parameters() if p.grad is not None])
                    for m in models
                ]
                weights = agg.aggregate(grads) if agg else [1.0/3]*3
                if zt:
                    zt_w = zt.verify(grads)
                    weights = [w * zw for w, zw in zip(weights, zt_w)]
                    s = sum(weights)
                    weights = [w/s for w in weights] if s > 0 else [1.0/3]*3
                for m, w in zip(models, weights):
                    for p in m.parameters():
                        if p.grad is not None:
                            p.grad.mul_(w * 3.0)
            for o in opts:
                o.step()

        # Validation
        for m in models:
            m.eval()
        top.eval()
        P, L = [], []
        with torch.no_grad():
            for x1, x2, x3, y in vfl_val:
                pr = torch.softmax(
                    top(torch.stack([models[0](x1), models[1](x2), models[2](x3)], dim=1)),
                    1
                ).numpy()
                P.extend(pr.argmax(1))
                L.extend(y.numpy())
        r = classification_report(L, P, output_dict=True, zero_division=0)
        m_val_f1 = r['macro avg']['f1-score'] * 100
        if m_val_f1 > best_f1:
            best_f1 = m_val_f1
            best_state = ([m.state_dict() for m in models], top.state_dict())

    if best_state:
        for m, sd in zip(models, best_state[0]):
            m.load_state_dict(sd)
        top.load_state_dict(best_state[1])

    # Final test evaluation
    for m in models:
        m.eval()
    top.eval()
    P, L, PR = [], [], []
    with torch.no_grad():
        for x1, x2, x3, y in vfl_te:
            pr = torch.softmax(
                top(torch.stack([models[0](x1), models[1](x2), models[2](x3)], dim=1)),
                1
            ).numpy()
            P.extend(pr.argmax(1))
            L.extend(y.numpy())
            PR.append(pr)
    L, P, PR = np.array(L), np.array(P), np.vstack(PR)
    r = classification_report(L, P, output_dict=True, zero_division=0)
    try:
        roc = roc_auc_score(L, PR, multi_class='ovr', average='macro')
    except Exception:
        roc = np.nan
    pr_auc = compute_pr_auc(L, PR)

    per_class = {}
    for c in [0, 1, 2]:
        per_class[f'precision_class{c}'] = r[str(c)]['precision'] * 100
        per_class[f'recall_class{c}'] = r[str(c)]['recall'] * 100

    return r['accuracy']*100, r['macro avg']['f1-score']*100, roc, pr_auc, per_class

