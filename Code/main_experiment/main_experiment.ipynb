# TABLE 7: COMPUTATIONAL OVERHEAD
# ==============================================================================
print("\n" + "="*90)
print("TABLE 7: COMPUTATIONAL OVERHEAD (37,418 patients)")
print("="*90)
try: 
    import psutil
    HAS_PS = True
except ImportError: 
    HAS_PS = False
    print("⚠️ psutil not found. Install via 'pip install psutil' for accurate CPU/RAM tracking.")

proc = psutil.Process() if HAS_PS else None
def measure(fn, label, comm_bytes=0):
    if proc: proc.cpu_percent(None)
    t0 = time.perf_counter()
    m0 = proc.memory_info().rss if proc else 0
    fn()
    dt = time.perf_counter() - t0
    m1 = proc.memory_info().rss if proc else 0
    cpu = proc.cpu_percent(None) if proc else np.nan
    bw = comm_bytes/dt/1e6 if comm_bytes else np.nan
    return {'Stage': label, 'Latency_ms': round(dt*1000,1), 'CPU_%': round(cpu,1) if cpu==cpu else '--',
            'Mem_MB': round((m1-m0)/1e6,1), 'BW_MBps': round(bw,2) if bw==bw else '--'}

np_ = sum(p.numel() for p in CentralFlex(17).parameters())*4
rows = [
    measure(lambda: train_central_flex(42, epochs=1), 'Centralized'),
    measure(lambda: train_hfl_flex(42, False, False, epochs=1), 'Federated Learning (FL)', np_*10),
    measure(lambda: train_hfl_flex(42, True, False, epochs=1), 'FL + Risk Layer', np_*10),
    measure(lambda: train_hfl_flex(42, True, True, epochs=1), 'FL + Zero Trust', np_*10)
]
df7 = pd.DataFrame(rows)
print(f"HW: {platform.processor() or platform.machine()} | PyTorch {torch.__version__}")
