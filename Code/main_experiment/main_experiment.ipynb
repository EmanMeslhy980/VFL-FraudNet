def full_metrics_local(y_true, proba):
    pred = proba.argmax(1)
    r = classification_report(y_true, pred, output_dict=True, zero_division=0)
    out = {
        'Acc': r['accuracy']*100, 
        'Pre': r['macro avg']['precision']*100,
        'Rec': r['macro avg']['recall']*100, 
        'F1': r['macro avg']['f1-score']*100
    }
    try: 
        out['ROC'] = roc_auc_score(y_true, proba, multi_class='ovr', average='macro')
    except Exception: 
        out['ROC'] = np.nan
    return out

def mean_metrics(list_m):
    keys = ['Acc','Pre','Rec','F1','ROC']
    return {k: np.mean([m[k] for m in list_m]) for k in keys}

