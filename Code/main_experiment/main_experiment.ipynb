def train_central_flex(seed, use_risk=False, tau_r=0.3, dp_sigma=None, epochs=10, eval_set='test'):
    set_all_seeds(seed)
    m = CentralFlex(X_tr_g.shape[1], use_risk=use_risk, tau_r=tau_r)
    opt = optim.Adam(m.parameters(), 1e-3)
    cr = nn.CrossEntropyLoss()
    dl = DataLoader(TensorDataset(torch.tensor(X_tr_g, dtype=torch.float32), torch.tensor(y_tr_g, dtype=torch.long)),
                    batch_size=512, shuffle=True, generator=make_generator(seed))
    m.train()
    for _ in range(epochs):
        for xb, yb in dl:
            opt.zero_grad()
            loss = cr(m(xb), yb)
            loss.backward()
            if dp_sigma: apply_dp(m, dp_sigma)
            opt.step()
    m.eval()
    Xe, ye = (X_te_g, y_te_g) if eval_set=='test' else (X_val_g, y_val_g)
    with torch.no_grad():
        proba = torch.softmax(m(torch.tensor(Xe, dtype=torch.float32)), 1).numpy()
    return full_metrics_local(ye, proba)

def train_hfl_flex(seed, use_risk, use_zt, tau_r=0.3, dp_sigma=None, epochs=8, n_clients=10, eval_set='test'):
    set_all_seeds(seed)
    shards = np.array_split(np.arange(len(X_tr_g)), n_clients)
    server = CentralFlex(X_tr_g.shape[1], use_risk=use_risk, tau_r=tau_r)
    cr = nn.CrossEntropyLoss()
    zt = ZeroTrustAggregator() if use_zt else None
    for rnd in range(epochs):
        deltas = []
        for k in range(n_clients):
            ck = CentralFlex(X_tr_g.shape[1], use_risk=use_risk, tau_r=tau_r)
            ck.load_state_dict(server.state_dict())
            opt = optim.Adam(ck.parameters(), 1e-3)
            Xk, yk = X_tr_g[shards[k]], y_tr_g[shards[k]]
            dl = DataLoader(TensorDataset(torch.tensor(Xk, dtype=torch.float32), torch.tensor(yk, dtype=torch.long)),
                            batch_size=256, shuffle=True, generator=make_generator(seed+k))
            ck.train()
            for xb, yb in dl:
                opt.zero_grad()
                loss = cr(ck(xb), yb)
                loss.backward()
                if dp_sigma: apply_dp(ck, dp_sigma)
                opt.step()
            d = torch.cat([p.flatten().clone() for p in ck.parameters()]) - \
                torch.cat([p.flatten().clone() for p in server.parameters()])
            deltas.append(d)
        if zt: 
            w = zt.verify(deltas)
            w = [x/sum(w) for x in w]
        else: 
            w = [1.0/n_clients]*n_clients
        with torch.no_grad():
            agg = sum(wi*d for wi, d in zip(w, deltas))
            off = 0
            for p in server.parameters():
                n = p.numel()
                p.add_(agg[off:off+n].view(p.shape))
                off += n
    server.eval()
    Xe, ye = (X_te_g, y_te_g) if eval_set=='test' else (X_val_g, y_val_g)
    with torch.no_grad():
        proba = torch.softmax(server(torch.tensor(Xe, dtype=torch.float32)), 1).numpy()
    return full_metrics_local(ye, proba)

def train_vfl_flex(seed, use_risk, use_zt, tau_r=0.3, dp_sigma=None, epochs=10, eval_set='test'):
    set_all_seeds(seed)
    d = DOM
    models = [BottomFlex(9, use_risk=use_risk, tau_r=tau_r) for _ in range(3)]
    top = TopModel(EMB_DIM)
    opts = [optim.AdamW(m.parameters(), 1e-3, weight_decay=1e-4) for m in models] + [optim.AdamW(top.parameters(), 1e-3)]
    cr = nn.CrossEntropyLoss()
    zt = ZeroTrustAggregator() if use_zt else None
    dl = DataLoader(VFLDataset(d['X1_tr'], d['X2_tr'], d['X3_tr'], d['y_tr']), batch_size=BS, shuffle=True, generator=make_generator(seed))

    def perturb(em):
        if dp_sigma is None: return em
        em = torch.clamp(em, -CLIP_NORM, CLIP_NORM)
        return em + torch.randn_like(em) * dp_sigma * CLIP_NORM

    for _ in range(epochs):
        for x1, x2, x3, y in dl:
            for o in opts: o.zero_grad()
            em = torch.stack([perturb(models[0](x1)), perturb(models[1](x2)), perturb(models[2](x3))], 1)
            loss = cr(top(em), y)
            loss.backward()
            for m in models: torch.nn.utils.clip_grad_norm_(m.parameters(), 1.0)
            if zt:
                grads = [torch.cat([p.grad.flatten() for p in m.parameters() if p.grad is not None]) for m in models]
                w = zt.verify(grads)
                w = [x/sum(w) for x in w]
                for m, ww in zip(models, w):
                    for p in m.parameters():
                        if p.grad is not None: p.grad.mul_(ww*3)
            for o in opts: o.step()

    for m in models: m.eval()
    top.eval()
    K1 = d['X1_te'] if eval_set=='test' else d['X1_val']
    K2 = d['X2_te'] if eval_set=='test' else d['X2_val']
    K3 = d['X3_te'] if eval_set=='test' else d['X3_val']
    ye = d['y_te'] if eval_set=='test' else d['y_val']
    PR = []
    with torch.no_grad():
        for i in range(0, len(K1), 2048):
            em = torch.stack([
                perturb(models[0](torch.tensor(K1[i:i+2048], dtype=torch.float32))),
                perturb(models[1](torch.tensor(K2[i:i+2048], dtype=torch.float32))),
                perturb(models[2](torch.tensor(K3[i:i+2048], dtype=torch.float32)))
            ], 1)
            PR.append(torch.softmax(top(em), 1).numpy())
    return full_metrics_local(ye, np.vstack(PR))

