def render_table_png(df, title, fname):
    fig, ax = plt.subplots(figsize=(max(9, df.shape[1]*1.5), max(2.5, df.shape[0]*0.42+1.6)))
    ax.axis('off')
    tbl = ax.table(cellText=[[f"{v:.2f}" if isinstance(v,float) else v for v in row] for row in df.values],
                   colLabels=df.columns, cellLoc='center', loc='center')
    tbl.auto_set_font_size(False)
    tbl.set_fontsize(9)
    tbl.scale(1, 1.5)
    for j in range(df.shape[1]): 
        tbl[0,j].set_facecolor('#d9d9d9')
        tbl[0,j].set_text_props(fontweight='bold')
    ax.set_title(title, fontsize=11, fontweight='bold', pad=14)
    plt.savefig(fname, dpi=200, bbox_inches='tight')
    plt.close()

tables = {
    'table4': (df4,'Table 4: Overall Comparison (37,418 patients)'),
    'table5': (df5,'Table 5: Differential Privacy Impact'),
    'table6': (df6,'Table 6: Risk Threshold Sensitivity'),
    'table7': (df7,'Table 7: Computational Overhead'),
    'table8': (df8,'Table 8: Ablation Study')
}
for key, (d, t) in tables.items(): 
    render_table_png(d, t, f'{key}.png')

def to_latex(df, cap, lab):
    s = f"\\begin{{table}}[htbp]\\centering\\caption{{{cap}}}\\label{{{lab}}}\\small\\begin{{tabular}}{{lccccc}}\\toprule\n"
    s += " & ".join([f"\\textbf{{{c}}}" for c in df.columns]) + " \\\\\\midrule\n"
    for _, r in df.iterrows():
        s += " & ".join([f"{v:.2f}" if isinstance(v,float) else str(v) for v in r.values]) + " \\\\\n"
    s += "\\bottomrule\\end{tabular}\\end{table}\n"
    return s

with open('tables_4_to_8_unified.tex','w') as f:
    f.write(to_latex(df4,'Overall comparison (37,418 patients, 3 seeds).','tbl4'))
    f.write(to_latex(df5,'Differential Privacy impact (computed $\\varepsilon$).','tbl5'))
    f.write(to_latex(df6,'Risk threshold sensitivity (validation split).','tbl6'))
    f.write(to_latex(df7,'Measured computational overhead.','tbl7'))
    f.write(to_latex(df8,'Ablation study (mean$\\pm$std, 3 seeds).','tbl8'))

