# SECTION 3: ARCHITECTURES
# ==============================================================================
class RiskGate(nn.Module):
    def __init__(self, h, tau_r=0.3, alpha=2.0, beta=10.0):
        super().__init__()
        self.r_net = nn.Linear(h, 1)
        self.tau_r, self.alpha, self.beta = tau_r, alpha, beta
    def forward(self, h):
        r = torch.sigmoid(self.r_net(h))
        g = 1.0 + self.alpha * torch.sigmoid(self.beta * (r - self.tau_r))
        return h * g

class BottomFlex(nn.Module):
    def __init__(self, inp, use_risk=True, tau_r=0.3, h=EMB_DIM):
        super().__init__()
        self.ffnn = nn.Sequential(
            nn.Linear(inp, 192), nn.ReLU(), nn.BatchNorm1d(192), nn.Dropout(0.1),
            nn.Linear(192, 192), nn.ReLU(), nn.BatchNorm1d(192), nn.Dropout(0.1)
        )
        self.risk = RiskGate(192, tau_r) if use_risk else None
    def forward(self, x):
        h = self.ffnn(x)
        return self.risk(h) if self.risk is not None else h

class CentralFlex(nn.Module):
    def __init__(self, inp, use_risk=True, tau_r=0.3):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(inp, 256), nn.ReLU(), nn.BatchNorm1d(256), nn.Dropout(0.1),
            nn.Linear(256, 256), nn.ReLU(), nn.BatchNorm1d(256), nn.Dropout(0.1),
            nn.Linear(256, 128), nn.ReLU()
        )
        self.risk = RiskGate(128, tau_r) if use_risk else None
        self.head = nn.Linear(128, 3)
    def forward(self, x):
        h = self.net(x)
        if self.risk is not None: h = self.risk(h)
        return self.head(h)

class TopModel(nn.Module):
    def __init__(self, h=EMB_DIM, n_cls=3):
        super().__init__()
        self.tr = nn.TransformerEncoder(
            nn.TransformerEncoderLayer(d_model=h, nhead=4, batch_first=True, dropout=0.1), num_layers=2
        )
        self.fc = nn.Sequential(
            nn.Linear(h, h//2), nn.ReLU(), nn.BatchNorm1d(h//2),
            nn.Dropout(0.2), nn.Linear(h//2, n_cls)
        )
    def forward(self, e): 
        return self.fc(self.tr(e).mean(dim=1))

class VFLDataset(Dataset):
    def __init__(self, X1, X2, X3, y):
        self.X1 = torch.tensor(X1, dtype=torch.float32)
        self.X2 = torch.tensor(X2, dtype=torch.float32)
        self.X3 = torch.tensor(X3, dtype=torch.float32)
        self.y = torch.tensor(y, dtype=torch.long)
    def __len__(self): 
        return len(self.y)
    def __getitem__(self, i): 
        return self.X1[i], self.X2[i], self.X3[i], self.y[i]

class ZeroTrustAggregator:
    def __init__(self, tau=3.0, mom=0.9): 
        self.tau, self.mom, self.mu, self.var = tau, mom, None, None
    def verify(self, grads):
        norms = torch.stack([g.norm() for g in grads])
        if self.mu is None: 
            self.mu = norms.mean().item()
            self.var = norms.var().item() if len(norms) > 1 else 1.0
        std = max(np.sqrt(self.var), 1e-5)
        w = [1.0 if abs(n.item() - self.mu) / std < self.tau else 0.05 for n in norms]
        self.mu = self.mom*self.mu + (1-self.mom)*norms.mean().item()
        self.var = self.mom*self.var + (1-self.mom)*(norms.var().item() if len(norms) > 1 else 0.0)
        return w

def apply_dp(model, sigma):
    torch.nn.utils.clip_grad_norm_(model.parameters(), CLIP_NORM)
    for p in model.parameters():
        if p.grad is not None: 
            p.grad.data += torch.randn_like(p.grad.data) * sigma * CLIP_NORM

